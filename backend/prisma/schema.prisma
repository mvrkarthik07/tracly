generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TxType {
  INCOME
  EXPENSE
}

enum Category {
  FOOD
  TRANSPORT
  BILLS
  SHOPPING
  ENTERTAINMENT
  HEALTH
  INCOME
  OTHER
}

enum Frequency {
  MONTHLY
}

model Transaction {
  id         String   @id @default(cuid())
  amount     Decimal  @db.Decimal(12, 2)
  type       TxType
  category   Category
  note       String?
  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  clientId   String?  @unique
  recurringId String?
  generatedForPeriod String?
  recurring RecurringTransaction? @relation(fields: [recurringId], references: [id], onDelete: SetNull)

  @@index([occurredAt])
  @@index([type])
  @@unique([recurringId, generatedForPeriod])
}

model RecurringTransaction {
  id         String   @id @default(cuid())
  amount     Decimal  @db.Decimal(12, 2)
  type       TxType
  category   Category
  note       String?
  frequency  Frequency @default(MONTHLY)
  dayOfMonth Int
  startDate  DateTime
  endDate    DateTime?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  transactions Transaction[]
}

model WeeklyReport {
  id           String   @id @default(cuid())
  weekStart    DateTime
  weekEnd      DateTime
  totalIncome  Decimal  @db.Decimal(12, 2)
  totalExpense Decimal  @db.Decimal(12, 2)
  net          Decimal  @db.Decimal(12, 2)
  byCategory   Json
  topCategory  String?
  generatedAt  DateTime @default(now())

  @@unique([weekStart, weekEnd])
}
